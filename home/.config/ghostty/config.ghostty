theme = Monokai Pro
font-family = "Operator Mono SSm Lig"
font-style = Book
font-style-bold = Bold
font-style-italic = Book Italic
font-style-bold-italic = Bold Italic
font-size = 15
# Keep the font's programming ligatures (like => and !=) on explicitly.
font-feature = +calt, +liga
background-opacity = 0.8
background-blur = 50

# Keep the folder out of the title bar: no folder icon, and a blank title that
# the shell and other programs can't change.
macos-titlebar-proxy-icon = hidden
title = " "

# Dim unfocused windows so the focused one is obvious at a glance.
custom-shader = shaders/dim-unfocused.glsl
# The shader doesn't animate, so only render when something changes.
custom-shader-animation = false

# Let programs in the terminal post macOS notifications (OSC 9 and OSC 777).
# Ghostty only shows one while the terminal that sent it isn't focused.
desktop-notifications = true

# Nix installs and updates Ghostty, so its own updater stays off.
auto-update = off
